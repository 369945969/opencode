        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>五子棋</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        body {\n            font-family: Arial, sans-serif;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            padding: 20px;\n        }\n        h1 {\n            color: white;\n            margin-bottom: 20px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n        }\n        .game-info {\n            background: white;\n            padding: 15px 30px;\n            border-radius: 10px;\n            margin-bottom: 20px;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n            text-align: center;\n        }\n        .game-info p {\n            font-size: 18px;\n            color: #333;\n            margin: 5px 0;\n        }\n        .current-player {\n            font-weight: bold;\n            color: #667eea;\n        }\n        .board-container {\n            background: #DEB887;\n            padding: 20px;\n            border-radius: 10px;\n            box-shadow: 0 8px 16px rgba(0,0,0,0.3);\n        }\n        #board {\n            display: grid;\n            grid-template-columns: repeat(15, 30px);\n            grid-template-rows: repeat(15, 30px);\n            gap: 0;\n            background: #DEB887;\n            position: relative;\n        }\n        .cell {\n            width: 30px;\n            height: 30px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            cursor: pointer;\n            position: relative;\n            z-index: 1;\n        }\n        .cell::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 0;\n            width: 100%;\n            height: 1px;\n            background: #8B4513;\n        }\n        .cell::after {\n            content: '';\n            position: absolute;\n            left: 50%;\n            top: 0;\n            width: 1px;\n            height: 100%;\n            background: #8B4513;\n        }\n        .piece {\n            width: 24px;\n            height: 24px;\n            border-radius: 50%;\n            position: relative;\n            z-index: 2;\n        }\n        .piece.black {\n            background: radial-gradient(circle at 30% 30%, #666, #000);\n            box-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n        }\n        .piece.white {\n            background: radial-gradient(circle at 30% 30%, #fff, #ccc);\n            box-shadow: 2px 2px 4px rgba(0,0,0,0.2);\n        }\n        .controls {\n            margin-top: 20px;\n            display: flex;\n            gap: 10px;\n        }\n        button {\n            padding: 10px 20px;\n            font-size: 16px;\n            border: none;\n            border-radius: 5px;\n            cursor: pointer;\n            background: white;\n            color: #667eea;\n            font-weight: bold;\n            transition: all 0.3s ease;\n        }\n        button:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 4px 8px rgba(0,0,0,0.2);\n        }\n        .winner {\n            position: fixed;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            background: white;\n            padding: 30px;\n            border-radius: 10px;\n            box-shadow: 0 8px 16px rgba(0,0,0,0.3);\n            text-align: center;\n            z-index: 1000;\n            display: none;\n        }\n        .winner.show {\n            display: block;\n            animation: fadeIn 0.3s ease;\n        }\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }\n            to { opacity: 1; transform: translate(-50%, -50%) scale(1); }\n        }\n    </style>\n</head>\n<body>\n    <h1>五子棋</h1>\n    <div class=\"game-info\">\n        <p>你是玩家 <span id=\"playerNum\" class=\"current-player\">-</span></p>\n        <p>当前回合: <span id=\"turn\" class=\"current-player\">-</span></p>\n        <p>连接状态: <span id=\"status\">连接中...</span></p>\n    </div>\n    <div class=\"board-container\">\n        <div id=\"board\"></div>\n    </div>\n    <div class=\"controls\">\n        <button onclick=\"resetGame()\">重新开始</button>\n    </div>\n    <div class=\"winner\" id=\"winner\">\n        <h2 id=\"winnerText\">玩家 X 获胜！</h2>\n        <br>\n        <button onclick=\"resetGame()\">再来一局</button>\n    </div>\n\n    <script>\n        const BOARD_SIZE = 15;\n        let ws;\n        let myPlayer = 0;\n        let currentTurn = 1;\n        let board = [];\n\n        function init() {\n            createBoard();\n            connect();\n        }\n\n        function createBoard() {\n            const boardEl = document.getElementById('board');\n            boardEl.innerHTML = '';\n            board = [];\n\n            for (let y = 0; y < BOARD_SIZE; y++) {\n                board[y] = [];\n                for (let x = 0; x < BOARD_SIZE; x++) {\n                    board[y][x] = 0;\n                    const cell = document.createElement('div');\n                    cell.className = 'cell';\n                    cell.dataset.x = x;\n                    cell.dataset.y = y;\n                    cell.onclick = () => makeMove(x, y);\n                    boardEl.appendChild(cell);\n                }\n            }\n        }\n\n        function connect() {\n            const wsUrl = 'ws://localhost:8080/ws?game=default';\n            ws = new WebSocket(wsUrl);\n\n            ws.onopen = () => {\n                document.getElementById('status').textContent = '已连接';\n            };\n\n            ws.onclose = () => {\n                document.getElementById('status').textContent = '连接断开';\n                setTimeout(connect, 3000);\n            };\n\n            ws.onerror = (error) => {\n                console.error('WebSocket error:', error);\n                document.getElementById('status').textContent = '连接错误';\n            };\n\n            ws.onmessage = (event) => {\n                const data = JSON.parse(event.data);\n                handleMessage(data);\n            };\n        }\n\n        function handleMessage(data) {\n            switch (data.type) {\n                case 'connected':\n                    myPlayer = data.player;\n                    document.getElementById('playerNum').textContent = myPlayer === 1 ? '黑棋' : '白棋';\n                    if (data.board) {\n                        board = data.board;\n                        renderBoard();\n                    }\n                    break;\n\n                case 'move':\n                    if (data.move) {\n                        board[data.move.y][data.move.x] = data.move.player;\n                    }\n                    currentTurn = data.turn;\n                    document.getElementById('turn').textContent = data.turn === 1 ? '黑棋 (玩家1)' : '白棋 (玩家2)';\n                    renderBoard();\n\n                    if (data.won) {\n                        const winnerText = data.winner === 1 ? '黑棋' : '白棋';\n                        document.getElementById('winnerText').textContent = `${winnerText} (${data.winner}号玩家) 获胜！`;\n                        document.getElementById('winner').classList.add('show');\n                    }\n                    break;\n\n                case 'error':\n                    alert(data.msg);\n                    break;\n            }\n        }\n\n        function renderBoard() {\n            const cells = document.querySelectorAll('.cell');\n            cells.forEach(cell => {\n                const x = parseInt(cell.dataset.x);\n                const y = parseInt(cell.dataset.y);\n                const value = board[y][x];\n\n                cell.innerHTML = '';\n                if (value !== 0) {\n                    const piece = document.createElement('div');\n                    piece.className = `piece ${value === 1 ? 'black' : 'white'}`;\n                    cell.appendChild(piece);\n                }\n            });\n        }\n\n        function makeMove(x, y) {\n            if (myPlayer === 0 || currentTurn !== myPlayer) {\n                return;\n            }\n            if (board[y][x] !== 0) {\n                return;\n            }\n\n            ws.send(JSON.stringify({ x, y }));\n        }\n\n        function resetGame() {\n            document.getElementById('winner').classList.remove('show');\n            if (ws) {\n                ws.send(JSON.stringify({ type: 'reset' }));\n            }\n        }\n\n        init();\n    </script>\n</body>\n</html>\n",
